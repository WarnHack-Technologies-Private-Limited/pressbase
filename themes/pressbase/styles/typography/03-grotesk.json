{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Grotesk",
	"settings": {
		"typography": {
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"src": ["file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"]
						}
					]
				},
				{
					"name": "Fira Code",
					"slug": "fira-code",
					"fontFamily": "\"Fira Code\", ui-monospace, monospace",
					"fontFace": [
						{
							"fontFamily": "\"Fira Code\"",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"src": ["file:./assets/fonts/fira-code/FiraCode-VariableFont_wght.woff2"]
						}
					]
				}
			]
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontWeight": "700",
					"letterSpacing": "-0.035em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontStyle": "normal",
					"fontWeight": "800",
					"letterSpacing": "-0.03em"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontStyle": "normal"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontStyle": "normal"
				}
			}
		}
	}
}
