{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Paper",
	"settings": {
		"appearanceTools": true,
		"border": {
			"radiusSizes": [
				{ "name": "Small", "slug": "sm", "size": "0.5rem" },
				{ "name": "Medium", "slug": "md", "size": "0.875rem" },
				{ "name": "Large", "slug": "lg", "size": "1.25rem" },
				{ "name": "Extra Large", "slug": "xl", "size": "2rem" },
				{ "name": "Full", "slug": "full", "size": "999px" }
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "color": "#f6f6f3", "name": "Paper", "slug": "base" },
				{ "color": "#ffffff", "name": "Surface", "slug": "surface" },
				{ "color": "#1b1b19", "name": "Ink", "slug": "contrast" },
				{ "color": "#5c5c57", "name": "Muted", "slug": "muted" },
				{ "color": "#e2e2dc", "name": "Border", "slug": "border" },
				{ "color": "#3b4cca", "name": "Indigo", "slug": "accent" },
				{ "color": "#3343c0", "name": "Indigo text", "slug": "accent-text" },
				{ "color": "#eef0fd", "name": "Indigo soft", "slug": "accent-soft" },
				{ "color": "#ffffff", "name": "On indigo", "slug": "on-accent" },
				{ "color": "#7a5af0", "name": "Violet", "slug": "violet" }
			],
			"gradients": [
				{
					"name": "Indigo to violet",
					"slug": "accent",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--accent) 0%, var(--wp--preset--color--violet) 100%)"
				},
				{
					"name": "Soft wash",
					"slug": "soft",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--accent-soft) 0%, var(--wp--preset--color--base) 100%)"
				},
				{
					"name": "Ink fade",
					"slug": "ink",
					"gradient": "linear-gradient(160deg, var(--wp--preset--color--contrast) 0%, color-mix(in srgb, var(--wp--preset--color--contrast) 85%, var(--wp--preset--color--accent)) 100%)"
				}
			]
		},
		"custom": {
			"glass": {
				"background": "color-mix(in srgb, var(--wp--preset--color--surface) 68%, transparent)",
				"border": "color-mix(in srgb, var(--wp--preset--color--contrast) 10%, transparent)",
				"blur": "18px"
			},
			"line": "color-mix(in srgb, var(--wp--preset--color--contrast) 12%, transparent)",
			"motion": {
				"ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
				"fast": "180ms",
				"base": "360ms"
			}
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 1px 2px rgb(20 20 18 / 0.05), 0 6px 20px -6px rgb(20 20 18 / 0.08)"
				},
				{
					"name": "Lifted",
					"slug": "lifted",
					"shadow": "0 2px 4px rgb(20 20 18 / 0.04), 0 16px 40px -12px rgb(20 20 18 / 0.16), 0 40px 80px -32px rgb(59 76 202 / 0.22)"
				},
				{
					"name": "Glow",
					"slug": "glow",
					"shadow": "0 1px 0 rgb(255 255 255 / 0.25) inset, 0 8px 24px -8px rgb(59 76 202 / 0.55)"
				},
				{
					"name": "Deep",
					"slug": "deep",
					"shadow": "0 24px 60px -20px rgb(20 20 18 / 0.35), 0 60px 120px -40px rgb(59 76 202 / 0.3)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Tiny", "size": "0.5rem", "slug": "20" },
				{ "name": "X-Small", "size": "1rem", "slug": "30" },
				{ "name": "Small", "size": "1.5rem", "slug": "40" },
				{ "name": "Regular", "size": "clamp(1.5rem, 4vw, 2.5rem)", "slug": "50" },
				{ "name": "Large", "size": "clamp(2.5rem, 6vw, 4rem)", "slug": "60" },
				{ "name": "X-Large", "size": "clamp(3.5rem, 8vw, 6rem)", "slug": "70" },
				{ "name": "XX-Large", "size": "clamp(4.5rem, 11vw, 8.5rem)", "slug": "80" }
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, \"Manrope Fallback\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontDisplay": "swap",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"src": ["file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"]
						}
					]
				},
				{
					"name": "Platypi",
					"slug": "platypi",
					"fontFamily": "Platypi, \"Platypi Fallback\", ui-serif, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Platypi",
							"fontDisplay": "swap",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"src": ["file:./assets/fonts/platypi/Platypi-VariableFont_wght.woff2"]
						},
						{
							"fontFamily": "Platypi",
							"fontDisplay": "swap",
							"fontStyle": "italic",
							"fontWeight": "300 800",
							"src": ["file:./assets/fonts/platypi/Platypi-Italic-VariableFont_wght.woff2"]
						}
					]
				},
				{
					"name": "System mono",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				},
				{
					"name": "Fira Code",
					"slug": "fira-code",
					"fontFamily": "\"Fira Code\", ui-monospace, monospace",
					"fontFace": [
						{
							"fontFamily": "\"Fira Code\"",
							"fontDisplay": "swap",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"src": ["file:./assets/fonts/fira-code/FiraCode-VariableFont_wght.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "fluid": false, "name": "Small", "size": "0.875rem", "slug": "small" },
				{ "fluid": { "min": "1rem", "max": "1.0625rem" }, "name": "Medium", "size": "1rem", "slug": "medium" },
				{ "fluid": { "min": "1.125rem", "max": "1.3125rem" }, "name": "Large", "size": "1.125rem", "slug": "large" },
				{ "fluid": { "min": "1.375rem", "max": "1.75rem" }, "name": "Extra Large", "size": "1.375rem", "slug": "x-large" },
				{ "fluid": { "min": "1.75rem", "max": "2.625rem" }, "name": "2X Large", "size": "1.75rem", "slug": "xx-large" },
				{ "fluid": { "min": "2.25rem", "max": "3.75rem" }, "name": "3X Large", "size": "2.25rem", "slug": "xxx-large" },
				{ "fluid": { "min": "2.625rem", "max": "5.75rem" }, "name": "Display", "size": "2.625rem", "slug": "display" }
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"letterSpacing": "-0.005em"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var:preset|border-radius|full"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|on-accent"
				},
				"shadow": "var:preset|shadow|glow",
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "0"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent",
						"text": "var:preset|color|on-accent"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|accent",
						"text": "var:preset|color|on-accent"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|platypi",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xxx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.4",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent-text"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			}
		},
		"blocks": {
			"core/avatar": {
				"border": {
					"radius": "var:preset|border-radius|full"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var:preset|color|accent",
							"width": "1px",
							"style": "solid"
						},
						"color": {
							"background": "transparent",
							"text": "var:preset|color|contrast"
						},
						"shadow": "none",
						"spacing": {
							"padding": {
								"top": "calc(0.875rem - 1px)",
								"bottom": "calc(0.875rem - 1px)",
								"left": "calc(1.5rem - 1px)",
								"right": "calc(1.5rem - 1px)"
							}
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "0.75rem"
				}
			},
			"core/code": {
				"border": {
					"color": "var:preset|color|border",
					"radius": "var:preset|border-radius|md",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|fira-code",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.7"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var:preset|spacing|40"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var:preset|color|border",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30"
					}
				},
				"css": "& summary{font-weight:600;font-size:var(--wp--preset--font-size--large);cursor:pointer;} & summary + *{margin-block-start:var(--wp--preset--spacing--30);color:var(--wp--preset--color--muted);}"
			},
			"core/navigation": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"core/post-author-name": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				}
			},
			"core/post-comments-form": {
				"css": "& textarea{background:var(--wp--preset--color--surface);color:var(--wp--preset--color--contrast);border:1px solid color-mix(in srgb,currentColor 55%,transparent);border-radius:var(--wp--preset--border-radius--sm);padding:.6rem .8rem;font:inherit;} & input:not([type=submit]):not([type=checkbox]){background:var(--wp--preset--color--surface);color:var(--wp--preset--color--contrast);border:1px solid color-mix(in srgb,currentColor 55%,transparent);border-radius:var(--wp--preset--border-radius--sm);padding:.6rem .8rem;font:inherit;} & label{font-size:var(--wp--preset--font-size--small);font-weight:600;}"
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|muted"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-excerpt": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"lineHeight": "1.6"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var:preset|border-radius|lg"
				}
			},
			"core/post-terms": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|accent-text"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent-text"
							}
						}
					}
				}
			},
			"core/pullquote": {
				"border": {
					"style": "none",
					"width": "0"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|platypi",
					"fontSize": "var:preset|font-size|xx-large",
					"fontStyle": "italic",
					"fontWeight": "500",
					"lineHeight": "1.2"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|platypi",
					"fontSize": "var:preset|font-size|x-large",
					"fontStyle": "italic",
					"lineHeight": "1.35"
				},
				"elements": {
					"cite": {
						"color": {
							"text": "var:preset|color|muted"
						},
						"typography": {
							"fontFamily": "var:preset|font-family|manrope",
							"fontSize": "var:preset|font-size|small",
							"fontStyle": "normal"
						}
					}
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{border-radius:var(--wp--preset--border-radius--full);border:1px solid color-mix(in srgb,currentColor 55%,transparent);background:var(--wp--preset--color--surface);color:var(--wp--preset--color--contrast);padding:.7rem 1.1rem;font-size:1rem;} & .wp-block-search__inside-wrapper{gap:.5rem;}",
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|border"
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|platypi",
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "italic",
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "postTypes": ["page"], "title": "Page without title" }
	]
}
