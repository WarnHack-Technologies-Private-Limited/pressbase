{
  "name": "@pressbase/core",
  "version": "0.1.0",
  "private": true,
  "description": "Pressbase's core server: kernel, REST API, installer, authentication.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@pressbase/blocks": "workspace:*",
    "@pressbase/db": "workspace:*",
    "@pressbase/hooks": "workspace:*",
    "@pressbase/theme-json": "workspace:*",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "htmlparser2": "12.0.0",
    "nodemailer": "10.0.15",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
