# Copy to .env and adjust. Every value is optional for local development:
# without DATABASE_URL the web installer asks for database details.

# PostgreSQL connection. Use "pglite:./.pressbase/db" for the embedded database.
# DATABASE_URL=postgres://pressbase:pressbase@localhost:5432/pressbase

# Where Pressbase keeps config.json, the embedded database and uploads.
# PRESSBASE_DATA_DIR=./.pressbase

# If set, the installer asks for this code before it will install.
# Strongly recommended for any server reachable from the internet.
# PRESSBASE_SETUP_TOKEN=

# Port for the core API server.
# PORT=4000

# Where the admin app reaches the core API (server-side requests).
# CORE_URL=http://localhost:4000

# Where the public site (apps/web) listens. The admin forwards public pages
# there, and core sends cache purges there (comma-separate several instances).
# WEB_URL=http://localhost:3001

# Public page cache (docs/adr/0008-public-page-caching.md). Set a long random
# secret (at least 16 characters, e.g. `openssl rand -hex 32`) to let apps/web
# cache pages for anonymous visitors; core uses it to purge them on changes.
# Without it, nothing is cached.
# PRESSBASE_REVALIDATE_SECRET=
# Memory the page cache may use, in MB.
# PRESSBASE_PAGE_CACHE_MB=64

# Outgoing email. Without SMTP, messages are saved to <data dir>/outbox instead.
# PRESSBASE_SMTP_URL=smtps://user:password@smtp.example.com:465
# Or as separate settings:
# PRESSBASE_SMTP_HOST=smtp.example.com
# PRESSBASE_SMTP_PORT=587
# PRESSBASE_SMTP_USER=
# PRESSBASE_SMTP_PASS=
# PRESSBASE_SMTP_SECURE=false
# PRESSBASE_MAIL_FROM="My Site <hello@example.com>"

# Accept application passwords over plain HTTP (trusted private networks only).
# PRESSBASE_ALLOW_HTTP_APP_PASSWORDS=1
