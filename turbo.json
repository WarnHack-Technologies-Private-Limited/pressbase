{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ADMIN_URL", "CORE_URL", "DATABASE_URL", "PORT", "PRESSBASE_*", "WEB_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["CORE_URL", "WEB_URL", "ADMIN_URL", "PRESSBASE_STANDALONE"]
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "@pressbase/plugin-sdk#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/core/src/**",
        "$TURBO_ROOT$/packages/*/src/**"
      ],
      "outputs": ["dist/**", "src/core.generated.d.ts"]
    },
    "@pressbase/plugin-sdk#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "pressbase-seo#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "pressbase-seo#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@pressbase/cli#test": {
      "dependsOn": ["^build", "pressbase-seo#build"],
      "outputs": []
    },
    "create-pressbase-plugin#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
