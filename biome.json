{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/migrations",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/*.generated.d.ts",
      "!**/playwright-report",
      "!**/test-results",
      "!**/next-env.d.ts",
      "!**/*.md",
      "!**/.claude",
      "!**/.pressbase",
      "!themes",
      "!apps/core/static"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
