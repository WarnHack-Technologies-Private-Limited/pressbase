{
  "name": "@pressbase/plugin-sdk",
  "version": "0.5.0",
  "description": "Types and tiny helpers for writing Pressbase plugins.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WarnHack-Technologies-Private-Limited/pressbase.git",
    "directory": "packages/plugin-sdk"
  },
  "keywords": [
    "pressbase",
    "plugin",
    "sdk",
    "cms"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "node scripts/generate-types.mjs && tsc -p tsconfig.build.json && node scripts/copy-types.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pressbase/core": "workspace:*",
    "@types/node": "26.6.5",
    "rollup": "4.24.0",
    "rollup-plugin-dts": "6.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
